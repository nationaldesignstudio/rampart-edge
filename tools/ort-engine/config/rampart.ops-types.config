# Same operator set as rampart.ops.config plus a global type allow-list
# (model tensors: float32, float16, uint8, int32, int64, bool). Drops double,
# int8/int16/uint16/uint32/uint64, string, float4/float8 kernels.
ai.onnx;18;Add,Cast,Concat,Constant,ConstantOfShape,DequantizeLinear,Div,Equal,Erf,Expand,Floor,Gather,LayerNormalization,MatMul,Mul,Reshape,Shape,Slice,Softmax,Sqrt,Sub,Transpose,Unsqueeze,Where
com.microsoft;1;BiasGelu,MatMulNBits
!globally_allowed_types;bool,uint8_t,int32_t,int64_t,float,MLFloat16
