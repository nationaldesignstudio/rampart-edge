{
  "name": "@nationaldesignstudio/rampart-edge",
  "version": "2.0.5",
  "description": "Rampart Edge — client-side PII gate for AI assistants: deterministic validators + one 1.45 MB ONNX model (onnxruntime-web) that decides BLOCK or ALLOW before a message leaves the browser and marks the PII spans to redact.",
  "license": "CC0-1.0",
  "homepage": "https://github.com/nationaldesignstudio/rampart-edge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nationaldesignstudio/rampart-edge.git"
  },
  "bugs": {
    "url": "https://github.com/nationaldesignstudio/rampart-edge/issues"
  },
  "keywords": [
    "pii",
    "privacy",
    "llm",
    "browser",
    "onnx",
    "onnxruntime-web",
    "classifier"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/src/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./redactor": {
      "types": "./dist/src/redactor.d.ts",
      "import": "./dist/redactor.js",
      "default": "./dist/redactor.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "examples",
    "index.ts",
    "CITATION.cff",
    "LICENSE",
    "model",
    "src",
    "runtime",
    "MODEL_CARD.md",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./index.ts ./src/worker.ts ./src/redactor.ts --outdir ./dist --entry-naming \"[name].[ext]\" --format esm --sourcemap --target browser --external onnxruntime-web && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify:public",
    "verify:public": "bun run build && bun run test && bun run type-check"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.22"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "onnxruntime-web": "1.30.0",
    "typescript": "5.9.2",
    "vitest": "4.1.8"
  },
  "packageManager": "bun@1.4.2"
}
